# Origem da API, sem /api/v1 (auth usa /auth).
# Com Docker e backend rodando no host:
API_UPSTREAM=http://host.docker.internal:8000
# Para npm start fora do Docker, use http://127.0.0.1:8000.
FRONT_PORT=8080
PORT=8080
# Em HTTPS, defina true e a origem pública exata.
COOKIE_SECURE=false
PUBLIC_ORIGIN=
# O backend ainda não lista lojas. Use IDs reais existentes no banco.
# Exemplo: [{"id":1,"name":"Minha hamburgueria","description":"Hambúrgueres e porções"}]
STORES_JSON=[]
