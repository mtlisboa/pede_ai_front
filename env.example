# Copie este arquivo para .env e ajuste os valores.
# Nunca coloque credenciais reais neste arquivo de exemplo.

# Origem do backend, sem /api/v1, caminhos ou credenciais.
# Execução local com npm start:
API_UPSTREAM=http://127.0.0.1:8000
# No Docker, se o backend roda no host:
# API_UPSTREAM=http://host.docker.internal:8000
# Para backend remoto, use a origem HTTPS real:
# API_UPSTREAM=https://seu-backend.exemplo.com

# Servidor do frontend.
HOST=0.0.0.0
PORT=8080
# Porta publicada pelo Docker Compose.
FRONT_PORT=8080

# Desenvolvimento HTTP. Em produção HTTPS, use COOKIE_SECURE=true.
COOKIE_SECURE=false
# Origem exata do FRONTEND, sem barra final.
# Deixe vazio no desenvolvimento para usar o host da requisição.
PUBLIC_ORIGIN=
# Exemplo em produção:
# PUBLIC_ORIGIN=https://seu-frontend.exemplo.com

# Lojas exibidas na tela inicial: use IDs reais existentes no backend.
STORES_JSON=[]
# Exemplo:
# STORES_JSON=[{"id":1,"name":"Minha hamburgueria","description":"Hambúrgueres e porções"}]
